{
  "actorSpecification": 1,
  "name": "linkedin-post-commenter-scraper",
  "title": "LinkedIn Post Commenter Scraper",
  "description": "Scrape commenters from LinkedIn posts by URL",
  "version": "0.0",
  "buildTag": "latest",
  "environmentVariables": {},
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn Post Commenter Scraper Output",
    "description": "Scraped LinkedIn profile data of commenters and reactors from a LinkedIn post.",
    "properties": {
      "results": {
        "type": "string",
        "title": "LinkedIn Post Commenters",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "publicIdentifier",
              "linkedInIdentifier",
              "memberIdentifier",
              "linkedInUrl",
              "firstName",
              "lastName",
              "headline",
              "summary",
              "location",
              "followerCount",
              "premium",
              "is_open_profile",
              "is_creator",
              "is_influencer",
              "is_self",
              "is_relationship",
              "websites",
              "connections_count",
              "birthdate",
              "positions",
              "schools",
              "skills",
              "languages",
              "recommendations",
              "volunteering_experience",
              "photoUrl",
              "backgroundUrl",
              "request_type",
              "reaction",
              "reaction_type",
              "comment"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
