{
  "title": "LinkedIn Post Commenter Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "posts": {
      "title": "Post URL",
      "type": "string",
      "description": "LinkedIn post URL",
      "editor": "textfield",
      "default": "https://www.linkedin.com/posts/google_googleio-io25-gemini-activity-7330295765424046080-nSW4"
    },
    "fileName": {
      "title": "Results File Name",
      "type": "string",
      "description": "Name of the output file",
      "editor": "textfield",
      "default": "linkedin-post-commenter-output"
    },
    "maxComments": {
      "title": "Maximum number of comments to scrape per each post",
      "type": "integer",
      "description": "Maximum comments to fetch",
      "editor": "number",
      "default": 10
    },
    "postedLimit": {
      "title": "Posted Limit (filter)",
      "type": "string",
      "description": "Filter by how recently the post was posted",
      "editor": "select",
      "enum": ["any", "24h", "week", "month", "3months", "6months", "year"],
      "enumTitles": ["any", "24h", "week", "month", "3months", "6months", "year"],
      "default": "any"
    }
  },
  "required": ["posts", "fileName"]
}
